{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "maxNodeModuleJsDepth": 0,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom", "vite/client"]
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "vite.config.js", "playwright.config.js", "tests/**/*.js"]
}
